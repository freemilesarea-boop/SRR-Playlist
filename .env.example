# Supabase (필수)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# 데모 모드 (선택) — 시연용
# true 로 설정하면, 빈 audio_url 트랙에 아래 URL을 라운드 로빈으로 채워줍니다.
# 저작권 안전을 위해 직접 권리를 확보한 음원 URL만 넣어주세요.
# 프로덕션에서는 false 유지.
VITE_ENABLE_DEMO_MODE=false
VITE_DEMO_AUDIO_URLS=https://example.com/demo-1.mp3,https://example.com/demo-2.mp3,https://example.com/demo-3.mp3
