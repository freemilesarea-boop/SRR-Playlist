# Supabase (필수)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Web Push 알림 (선택)
# - 클라이언트에서 PushManager.subscribe 시 사용. 미설정 시 알림 기능 hidden.
# - VAPID key pair 생성: npx web-push generate-vapid-keys
# - public key 만 클라이언트 노출. private key 는 Supabase Edge Function Secrets 에만.
VITE_VAPID_PUBLIC_KEY=

# Sentry 운영 에러 추적 (선택, 강력 권장)
# - https://sentry.io 가입 → 새 프로젝트(React) 생성 → DSN 복사
# - 미설정 시 silent skip (dev 빌드 / dsn 없으면 init 자체 안 함)
# - 설정 즉시: 운영 에러 / 자동 전환 실패 / 관리자 패널 에러 등 자동 수집
VITE_SENTRY_DSN=
# 환경 라벨 (production / preview / test / local). AI-ENV-1 환경 가드가 사용.
# - production: Production Supabase 연결. Test 배너 미표시.
# - preview/test/local: 격리된 Test/Preview Supabase 만 허용. Test 배너 표시.
VITE_APP_ENV=production

# AI-ENV-1 — 기대 Supabase Project Ref (URL 의 <ref>.supabase.co).
# - Preview/Test 환경에서 실제 연결 Ref 와 다르면 앱을 Block Screen 으로 차단한다.
# - Preview 환경에는 반드시 격리 Test 프로젝트 Ref 만 설정. Production Ref 설정 금지.
VITE_EXPECTED_SUPABASE_PROJECT_REF=your-project-ref

# 데모 모드 (선택) — 시연용
# true 로 설정하면, 빈 audio_url 트랙에 아래 URL을 라운드 로빈으로 채워줍니다.
# 저작권 안전을 위해 직접 권리를 확보한 음원 URL만 넣어주세요.
# 프로덕션에서는 false 유지.
VITE_ENABLE_DEMO_MODE=false
VITE_DEMO_AUDIO_URLS=https://example.com/demo-1.mp3,https://example.com/demo-2.mp3,https://example.com/demo-3.mp3

# Kakao Developers (선택 — 카카오 로그인 / 카카오톡 공유)
# - JS Key: 브라우저 노출 OK. https://developers.kakao.com → 앱 → 플랫폼 키.
# - REST API Key / Admin Key 는 서버 전용 — Supabase Edge Function Secrets 로만 설정:
#     supabase secrets set KAKAO_REST_API_KEY=... KAKAO_ADMIN_KEY=...
# - Supabase Auth 카카오 provider 활성화도 별도 (Dashboard → Auth → Providers → Kakao):
#     · OAuth Client ID = REST API Key
#     · OAuth Client Secret = Kakao 보안 → Client Secret 코드 (별도 발급 필요)
#     · Redirect URL = https://{ref}.supabase.co/auth/v1/callback
VITE_KAKAO_JS_KEY=

# 카카오톡 채널 ID (시크릿 아님 — pf.kakao.com URL 의 _xxxxxxxx 부분)
# 예: https://pf.kakao.com/_xgHxbGX → VITE_KAKAO_CHANNEL_PUBLIC_ID=_xgHxbGX
VITE_KAKAO_CHANNEL_PUBLIC_ID=

# 카카오 OAuth 로그인 활성화 토글 (X6.13)
# - 카카오 비즈 앱 심사 + Supabase Auth provider 활성화 완료 전까지 false 유지.
# - false (또는 미정의) → 로그인/가입 화면에서 카카오 버튼 숨김.
#   채팅 채널 URL 진입 / 이미 카카오 연결된 사용자 동선은 영향 없음.
# - 심사 통과 후 true 로 변경 + 재배포만으로 즉시 노출 복구.
VITE_ENABLE_KAKAO_LOGIN=false


# =============================================================================
# 서버 전용 시크릿 (브라우저 노출 금지 — VITE_ 접두사 없음)
# =============================================================================
# 아래 값들은 .env(프론트 빌드)에 넣지 마세요. 다음 위치에만 설정합니다:
#   - Vercel: Project Settings → Environment Variables (서버리스 함수 api/cron/* 용)
#   - Supabase: `supabase secrets set KEY=...` (Edge Functions 용)
# 자세한 배포 절차/스모크 테스트: docs/PHASE1_DEPLOY_CHECKLIST.md
#
# [Cron / Enterprise 운영 자동화 — Phase 1]
# CRON_SECRET                 Vercel Cron 인증. /api/cron/* 가 Authorization: Bearer <CRON_SECRET> 검증.
#                             생성 예: openssl rand -hex 32  (Vercel + Supabase secrets 양쪽 동일 값)
# SUPABASE_URL                Supabase 프로젝트 URL (서버 런타임용; VITE_SUPABASE_URL 과 동일 값).
# SUPABASE_SERVICE_ROLE_KEY   service_role 키 (RLS 우회, 서버 전용). cron → RPC/edge 호출에 사용.
#                             절대 클라이언트/깃에 커밋 금지. VITE_ 접두사 금지(번들 노출 차단).
#
# [AI-ENV-1 — Test/Preview 외부 연동 Kill Switch (서버 전용, 기본 차단)]
# TEST_EMAIL_PROVIDER_DISABLED=true      Test 환경 이메일 발송 차단.
# TEST_SMS_PROVIDER_DISABLED=true        Test 환경 SMS/Push 발송 차단.
# TEST_PAYMENT_PROVIDER_DISABLED=true    Test 환경 결제/정산 호출 차단.
# TEST_WEBHOOKS_DISABLED=true            Test 환경 Webhook/외부 매장 제어 차단.
#   ※ 미설정이어도 비-Production(preview/test/local)에서는 클라이언트 가드가 안전측(차단)으로 처리.
#   ※ Production Service Role Key 를 Test 환경에서 재사용 금지 — 별도 Test 프로젝트 키만 사용.
#
# [이메일 발송 — Resend (dispatch-admin-notifications)]
# RESEND_API_KEY              Resend API 키 (re_...). 미설정 시 이메일 발송 skip(생성만).
# RESEND_FROM                 발신 주소. 기본값 "듣다 운영 <no-reply@deudda.com>" (Resend 도메인 인증 필요).
#
# [운영 알림 채널 — DB 설정(admin_settings), env 아님]
#   알림 발송은 env 가 아니라 admin_settings 키로 제어합니다 (관리자 RPC/대시보드에서 설정):
#     notification_slack_webhook_url   Slack Incoming Webhook URL (https://hooks.slack.com/...).
#                                      빈 값/미설정 → Slack 발송 skip.
#     notification_email_enabled       true/false — 이메일 발송 on/off.
#     notification_email_to            수신 주소(쉼표 구분 다중).
#     notification_min_severity        info|warning|error (기본 warning) — 이 미만 알림은 발송 안 함.
#   ※ admin_notifications.kind='noc_alert' 는 major→warning / critical→error 로 매핑되어
#     기본 min_severity=warning 에서 모두 발송됩니다.
