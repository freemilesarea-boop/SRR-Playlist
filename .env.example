# Supabase (필수)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Web Push 알림 (선택)
# - 클라이언트에서 PushManager.subscribe 시 사용. 미설정 시 알림 기능 hidden.
# - VAPID key pair 생성: npx web-push generate-vapid-keys
# - public key 만 클라이언트 노출. private key 는 Supabase Edge Function Secrets 에만.
VITE_VAPID_PUBLIC_KEY=

# Sentry 운영 에러 추적 (선택, 강력 권장)
# - https://sentry.io 가입 → 새 프로젝트(React) 생성 → DSN 복사
# - 미설정 시 silent skip (dev 빌드 / dsn 없으면 init 자체 안 함)
# - 설정 즉시: 운영 에러 / 자동 전환 실패 / 관리자 패널 에러 등 자동 수집
VITE_SENTRY_DSN=
# 환경 라벨 (production / staging / preview). 미설정 시 Vite MODE 자동 사용.
VITE_APP_ENV=production

# 데모 모드 (선택) — 시연용
# true 로 설정하면, 빈 audio_url 트랙에 아래 URL을 라운드 로빈으로 채워줍니다.
# 저작권 안전을 위해 직접 권리를 확보한 음원 URL만 넣어주세요.
# 프로덕션에서는 false 유지.
VITE_ENABLE_DEMO_MODE=false
VITE_DEMO_AUDIO_URLS=https://example.com/demo-1.mp3,https://example.com/demo-2.mp3,https://example.com/demo-3.mp3

# Kakao Developers (선택 — 카카오 로그인 / 카카오톡 공유)
# - JS Key: 브라우저 노출 OK. https://developers.kakao.com → 앱 → 플랫폼 키.
# - REST API Key / Admin Key 는 서버 전용 — Supabase Edge Function Secrets 로만 설정:
#     supabase secrets set KAKAO_REST_API_KEY=... KAKAO_ADMIN_KEY=...
# - Supabase Auth 카카오 provider 활성화도 별도 (Dashboard → Auth → Providers → Kakao):
#     · OAuth Client ID = REST API Key
#     · OAuth Client Secret = Kakao 보안 → Client Secret 코드 (별도 발급 필요)
#     · Redirect URL = https://{ref}.supabase.co/auth/v1/callback
VITE_KAKAO_JS_KEY=
