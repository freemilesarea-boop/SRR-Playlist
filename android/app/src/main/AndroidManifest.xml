<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- OAuth(구글/카카오) 딥링크: com.deudda.app://auth/callback 로 앱 복귀.
                 nativeAuth.ts 의 NATIVE_OAUTH_REDIRECT 와 스킴 일치. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.deudda.app" />
            </intent-filter>

        </activity>

        <!-- 매장 음악 백그라운드 재생 유지(소리는 WebView 가 낸다 — 이 서비스는 프로세스 보호용). -->
        <service
            android:name=".StorePlaybackService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false" />

        <!-- 재부팅 후 복귀. Activity 를 직접 띄우지는 못한다(Android 10+ 백그라운드
             Activity 시작 제한) — 포그라운드 서비스를 올려 상시 알림 한 번 탭으로
             플레이어를 열 수 있게 하는 것이 이 리시버가 보장하는 전부다. -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:directBootAware="false">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 매장/브랜드 플레이어의 화면 꺼짐 방지(@capacitor-community/keep-awake).
         화면이 꺼지면 WebView 가 스로틀되어 24시간 연속 재생이 끊긴다. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 푸시 알림(FCM). Android 13(API 33)+ 는 런타임 권한이 필요하다.
         권한 요청은 @capacitor/push-notifications 의 requestPermissions() 가 수행. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 백그라운드 음악 재생. 포그라운드 서비스가 없으면 안드로이드가 백그라운드
         프로세스의 오디오를 중단시킨다(메모리 압박 · Doze). mediaPlayback 타입은
         음악 앱의 정당한 용도이며, Play Console 의 FGS 타입 신고 대상이다. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- 재부팅 후 매장 재생 서비스 복귀(BootReceiver). Activity 자동 실행 권한이 아니다. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 배터리 최적화는 **조회만** 한다(PowerManager.isIgnoringBatteryOptimizations).
         이 조회에는 권한이 필요 없다. 자동 예외 요청 다이얼로그를 쓰지 않으므로
         REQUEST_IGNORE_BATTERY_OPTIMIZATIONS 권한은 선언하지 않는다 —
         쓰지 않는 민감 권한을 선언하면 Play 심사에서 정당화를 요구받는다.
         사용자는 설정 화면으로 안내만 하고 선택은 사람이 한다. -->
</manifest>
